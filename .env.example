# This documents every key the real secrets file needs — it holds no real
# values itself and is safe to commit. The real secrets live encrypted at
# the repo root in .env.enc (sops/age) — see
# docs/adr/0123-sops-encrypted-root-env.md. To edit them: `mise run secrets-edit`
# (wraps `sops .env.enc`, opens a decrypted buffer in $EDITOR, re-encrypts on
# save). workloads/root.hcl decrypts .env.enc in-memory on every invocation;
# no plaintext copy is ever written to disk.

# Scaleway
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=
SCALEWAY_ORGANIZATION_ID=
SCALEWAY_PROJECT_ID_NOISYPIGEON_COM=
SCALEWAY_PROJECT_ID_PIGEON_DEV=
# Also the Terraform state backend for scaleway/* and cloudflare/*.
SCALEWAY_TERRAFORM_STATE_BUCKET_NAME=

# Cloudflare — noisypigeon.com and pigeon.dev are different Cloudflare
# accounts, so each domain gets its own token/account id.
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID_NOISYPIGEON_COM=
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID_PIGEON_DEV=
